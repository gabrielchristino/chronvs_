{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Chronvs: Build",
            "type": "process",
            "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
            "args": ["run"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "Chronvs: Upload",
            "type": "process",
            "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
            "args": ["run", "--target", "upload"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"]
        }
    ]
}
